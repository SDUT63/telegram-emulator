# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Build directory
build/
dist/

# Database files
data/
*.db
*.sqlite
*.sqlite3

# Log files
logs/
*.log

# Environment files
.env
.env.local
.env.*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node.js (for future frontend development)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/

# Configuration files with sensitive data
configs/local.yaml
configs/production.yaml

# examples
__pycache__/
*.pyc
examples/__pycache__/
bot_offset_*.txt
# Чат-бот СДУТ: ключ доступа и персональные данные обратившихся.
# Эти файлы не должны попадать в репозиторий ни при каких условиях.
token.txt
survey_responses.json
survey_responses.json.tmp
survey_responses.json.broken
survey_responses.csv
demo_responses.json
demo_responses.csv

# Свой список доверенных сертификатов — у каждого компьютера он свой
certs.pem

# CRM оператора: пароли, заметки о людях, очередь сообщений.
# Всё это персональные данные и секреты — в репозиторий не попадает.
operators.json
crm_data.json
.crm_secret
outbox/

# Выгрузки в Excel: там имена, телефоны и состояние людей
*.xlsx
# Кроме проектных документов — в них данных людей нет
!docs/*.xlsx
