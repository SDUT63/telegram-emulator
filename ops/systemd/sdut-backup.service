[Unit]
Description=СДУТ: зашифрованная резервная копия базы
After=postgresql.service

[Service]
Type=oneshot
User=sdut
Group=sdut
WorkingDirectory=/opt/sdut
EnvironmentFile=/etc/sdut/bot.env
ExecStart=/opt/sdut/ops/backup_postgres.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sdut-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
