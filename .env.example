# MAX bot token. Do not commit a real token.
MAX_BOT_TOKEN=

# Local durable storage for the laptop/pilot launcher.
SDUT_DB_PATH=data/sdut_bot.sqlite3

# Production durable storage. If set, the webhook launcher uses PostgreSQL.
# Keep this secret out of Git and environment dumps.
SDUT_DATABASE_URL=postgresql://sdut_user:CHANGE_ME@127.0.0.1:5432/sdut

# Production Webhook: PUBLIC URL must be HTTPS on port 443.
# Recommended: https://public-domain/max -> reverse proxy -> 127.0.0.1:8080/max
MAX_WEBHOOK_URL=https://bot.example.ru/max
MAX_WEBHOOK_PATH=/max
MAX_WEBHOOK_HOST=127.0.0.1
MAX_WEBHOOK_PORT=8080
MAX_WEBHOOK_SECRET=
