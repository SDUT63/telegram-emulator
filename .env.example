# MAX bot token. Do not commit a real token.
MAX_BOT_TOKEN=

# Local durable storage for the laptop/pilot launcher only.
SDUT_DB_PATH=data/sdut_bot.sqlite3

# Production durable storage. The DSN must be reachable from the container/host.
# Keep this secret out of Git and environment dumps.
SDUT_DATABASE_URL=postgresql://sdut_user:CHANGE_ME@127.0.0.1:5432/sdut

# Explicit environment marker used by the production launcher.
SDUT_ENV=production

# Production Webhook: PUBLIC URL must be HTTPS on port 443.
# Recommended: https://public-domain/max -> reverse proxy -> 127.0.0.1:8080/max
MAX_WEBHOOK_URL=https://bot.example.ru/max
MAX_WEBHOOK_PATH=/max
MAX_WEBHOOK_HOST=127.0.0.1
MAX_WEBHOOK_PORT=8080
MAX_WEBHOOK_SECRET=

# Required for production monitoring. Use a secret-manager generated value;
# never expose /metrics publicly.
SDUT_METRICS_TOKEN=

# Technical retention. Final periods must follow the approved privacy policy.
SDUT_DELETED_USER_RETENTION_DAYS=30
SDUT_DELETED_EVENT_TOMBSTONE_RETENTION_DAYS=30
SDUT_OUTBOX_SENT_RETENTION_DAYS=30
